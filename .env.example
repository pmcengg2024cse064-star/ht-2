# ==============================================================================
# HACKUP TECHNOLOGY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# For Local Development: Copy this file to .env.local
# For Vercel Production: Add these under Vercel Project Settings > Environment Variables
# NEVER commit real credentials, private keys, or tokens to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / CLIENT-SIDE PUBLIC VARIABLES (Exposed in Vite Browser Bundle)
# ------------------------------------------------------------------------------
# MUST be prefixed with VITE_. Safe for public browser consumption.

# Supabase Public API Endpoint (Required for browser authentication & RPCs)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous/Publishable Key (Public RLS-constrained key)
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Cloudflare Turnstile Public Site Key (Rendered in browser forms)
VITE_TURNSTILE_SITE_KEY="0x4AAAAAA..."

# Calendly Booking URL (Used by "Let's Collaborate" hero button)
VITE_CALENDLY_URL="https://calendly.com/hackuptechnology/executive-consultation"

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY VARIABLES (Vercel Serverless Functions Runtime)
# ------------------------------------------------------------------------------
# DO NOT prefix these with VITE_. These are strictly protected secrets.
# NEVER expose these in browser bundles or client-side responses.

# Supabase Server API Endpoint (Optional: will fallback to VITE_SUPABASE_URL if unset)
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Service Role Key (Full database access for serverless admin operations & bypass RLS)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# Cloudflare Turnstile Secret Key (Server-side token verification with Cloudflare API)
TURNSTILE_SECRET_KEY="0x4AAAAAA_SECRET..."

# Resend API Key (Transactional email dispatch for enquiry alerts)
RESEND_API_KEY="re_123456789_abcdefg"

# Verified Sender Email Address (Must be a domain verified in Resend)
EMAIL_FROM="Hackup Technology <notifications@hackuptechnology.com>"

# Notification Recipient Emails (Comma-separated addresses for new enquiry alerts)
NOTIFICATION_RECIPIENT_EMAILS="info@hackuptechnology.com,dinesh@hackuptechnology.com"

# Turnstile Allowed Hostnames (Comma-separated hostnames authorized to submit forms)
# Example for Staging: "hackuptechnology.com,www.hackuptechnology.com,staging.hackuptechnology.com,localhost"
TURNSTILE_ALLOWED_HOSTNAMES="hackuptechnology.com,www.hackuptechnology.com,localhost,127.0.0.1"
